{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["at any time"],
  "dependencyDashboard": false,
  "prCreation": "approval",
  "branchPrefix": "feat/renovate-",
  "semanticCommitType": "feat",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["archlinux"],
      "versioning": "regex:^base-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "matchPackageNames": ["*"],
      "groupName": "dependencies"
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": "major dependencies"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["archlinux"],
      "groupName": "dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Containerfile$/"],
      "matchStrings": ["ENV MISE_VERSION=\"(?<currentValue>v[^\"\\s]+)\""],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
